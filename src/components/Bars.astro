---
// Planned (base + contingency stacked) vs spent, per row.
const { rows } = Astro.props as { rows: { label: string; base: number; contingency: number; spent: number }[] };
const W = 760, H = 290, pad = 44, max = Math.max(1, ...rows.map((r) => Math.max(r.base + r.contingency, r.spent)));
const bw = (W - pad * 2) / rows.length;
const y = (v: number) => H - pad - (v / max) * (H - pad * 2);
const h = (v: number) => (v / max) * (H - pad * 2);
---
<svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Base budget, contingency and spent by phase. Exact figures are in the table below.">
  <defs><pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" fill="#ead9bd" /><line x1="0" y1="0" x2="0" y2="6" stroke="#7a5230" stroke-width="2" /></pattern></defs>
  {[0, 0.5, 1].map((t) => <g><line x1={pad} x2={W - pad / 2} y1={y(max * t)} y2={y(max * t)} stroke="#d9cdb8" stroke-dasharray="3 4" /><text x={pad - 6} y={y(max * t) + 4} text-anchor="end">${Math.round(max * t)}</text></g>)}
  {rows.map((r, i) => {
    const x = pad + i * bw + bw * 0.16, w = bw * 0.32;
    return <g>
      <rect x={x} y={y(r.base)} width={w} height={h(r.base)} fill="#c9a26b"><title>{r.label} base ${r.base}</title></rect>
      {r.contingency > 0 && <rect x={x} y={y(r.base + r.contingency)} width={w} height={h(r.contingency)} fill="url(#hatch)" stroke="#7a5230" stroke-width="1"><title>{r.label} contingency ${r.contingency}</title></rect>}
      <rect x={x + w + 3} y={y(r.spent)} width={w} height={Math.max(1, h(r.spent))} fill="#b5462e"><title>{r.label} spent ${r.spent}</title></rect>
      <text x={x + w} y={H - pad + 18} text-anchor="middle">{r.label}</text>
    </g>;
  })}
</svg>
<p class="muted legend" style="font-size:.85rem"><span class="sw" style="background:#c9a26b"></span> base budget &nbsp; <span class="sw hatch"></span> contingency (hatched) &nbsp; <span class="sw" style="background:#b5462e"></span> spent (right bar)</p>
