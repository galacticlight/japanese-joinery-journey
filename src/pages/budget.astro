---
import Base from '../layouts/Base.astro';
import Bars from '../components/Bars.astro';
import site from '../data/site.json';
import { phases, allExpenses, budgetRows, usd } from '../lib';
const rows = budgetRows();
const sum = (k: 'base' | 'contingency' | 'spent' | 'remaining') => rows.reduce((a, r) => a + r[k], 0);
const T = { base: sum('base'), contingency: sum('contingency'), spent: sum('spent'), remaining: sum('remaining') };
const notes: Record<string, string> = Object.fromEntries([...phases.map((p) => [p.id, p.budgetNote]), [site.unplanned.id, site.unplanned.note]]);
const names: Record<string, string> = Object.fromEntries(rows.map((r) => [r.id, `${r.label} · ${r.name}`]));
const state = (r: (typeof rows)[number]) => r.overTotal ? 'over' : r.overBase ? 'contingency' : 'ok';
---
<Base title="Budget" description="Base budget, contingency, spent and remaining, by phase.">
  <p class="eyebrow">金 · Budget</p><h1>Every dollar, in the open.</h1>
  <div class="grid">
    <div class="card stat"><div class="n">{usd(T.base)}</div><div class="l">base budget, all phases</div></div>
    <div class="card stat"><div class="n">{usd(T.contingency)}</div><div class="l">scrap / contingency allowance</div></div>
    <div class="card stat"><div class="n">{usd(T.spent)}</div><div class="l">spent so far</div></div>
    <div class="card stat"><div class="n">{T.remaining < 0 ? `−${usd(-T.remaining)}` : usd(T.remaining)}</div><div class="l">{T.remaining < 0 ? 'over budget' : 'remaining'}</div></div>
  </div>
  <section class="card reveal"><h2>Budget vs spent</h2><Bars rows={rows} /></section>
  <section class="card reveal table-wrap"><h2>By phase</h2>
    <p class="muted" style="font-size:.9rem">Contingency is {site.contingencyPct}% of each phase's lumber/material estimate (a phase can override it). Remaining = base + contingency − spent.</p>
    <table><thead><tr><th>Phase</th><th>What it covers</th><th class="num">Base</th><th class="num">Contingency</th><th class="num">Spent</th><th class="num">Remaining</th><th>Status</th></tr></thead>
    <tbody>{rows.map((r) => <tr>
      <td>{r.label} · {r.name}</td><td class="muted">{notes[r.id]}</td>
      <td class="num">{usd(r.base)}</td><td class="num">{r.contingency ? usd(r.contingency) : '—'}</td><td class="num">{usd(r.spent)}</td>
      <td class="num">{r.remaining < 0 ? `−${usd(-r.remaining)}` : usd(r.remaining)}</td>
      <td>{state(r) === 'over' ? <span class="badge s-over">⚠ Over by {usd(-r.remaining)}</span> : state(r) === 'contingency' ? <span class="badge s-in-progress">◐ Using contingency</span> : <span class="badge s-done">✓ On budget</span>}</td>
    </tr>)}</tbody>
    <tfoot><tr><th scope="row" colspan="2">Total</th><td class="num"><strong>{usd(T.base)}</strong></td><td class="num"><strong>{usd(T.contingency)}</strong></td><td class="num"><strong>{usd(T.spent)}</strong></td><td class="num"><strong>{T.remaining < 0 ? `−${usd(-T.remaining)}` : usd(T.remaining)}</strong></td><td></td></tr></tfoot></table>
  </section>
  <section class="card reveal table-wrap"><h2>Expense log</h2>
    {allExpenses.length === 0 ? <p class="muted">Nothing purchased yet — $0 spent. Purchases appear here as they happen.</p> :
    <table><thead><tr><th>Date</th><th>Item</th><th>Category</th><th>Phase</th><th class="num">Amount</th></tr></thead><tbody>{allExpenses.map((e) => <tr><td>{e.date}</td><td>{e.item}</td><td>{e.category ?? '—'}</td><td>{names[e.phase] ?? e.phase}</td><td class="num">{usd(e.amount)}</td></tr>)}</tbody></table>}
  </section>
</Base>
